# Copy to .env for local development. .env is git-ignored.

PORT=8080

DATABASE_URL=postgres://wedding:wedding@localhost:5432/wedding?sslmode=disable

# RSVP access code. Override in any non-local environment.
ACCESS_CODE=letmein

# HMAC key for the RSVP auth cookie. Override in any non-local environment.
SESSION_SECRET=dev-secret-do-not-use-in-prod
